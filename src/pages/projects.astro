---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import projectsData from '../data/projects.json';
import { url } from '../utils/paths';

const projects = projectsData;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects | ${SITE_TITLE}`} description="Research projects and public engagement initiatives." />
		<style>
			.projects-section {
				max-width: var(--max-width);
				margin: 0 auto;
			}
			.projects-hero {
				margin-bottom: 3rem;
				padding: 2rem 0 0;
			}
			.projects-hero h1 {
				font-family: var(--font-serif);
				font-size: 2.75rem;
				margin: 0 0 1rem 0;
				color: var(--color-text-main);
				letter-spacing: -0.02em;
				line-height: 1.2;
			}
			.projects-hero p {
				font-size: 1.1rem;
				color: var(--color-text-muted);
				max-width: 700px;
				line-height: 1.7;
			}
			.project-list {
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
				margin-bottom: 3.5rem;
			}
			.project-card {
				background-color: var(--color-bg-offset);
				border: 1px solid var(--color-border);
				border-radius: 16px;
				padding: 2rem;
			}
			.project-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 0.5rem 1rem;
				margin-bottom: 0.5rem;
			}
			.project-card h2 {
				font-family: var(--font-serif);
				font-size: 1.5rem;
				margin: 0;
				border-bottom: none;
				padding-bottom: 0;
				display: block;
				color: var(--color-text-main);
				line-height: 1.3;
			}
			.project-status {
				font-size: 0.75rem;
				color: var(--color-accent);
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				white-space: nowrap;
			}
			.project-meta-line {
				font-size: 0.9rem;
				color: var(--color-text-muted);
				margin-bottom: 1.1rem;
			}
			.project-description {
				color: var(--color-text-muted);
				font-size: 1rem;
				line-height: 1.7;
				margin-bottom: 1.25rem;
			}
			.project-outputs {
				border-top: 1px solid var(--color-border);
				padding-top: 1.1rem;
			}
			.project-outputs-label {
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--color-text-muted);
				margin-bottom: 0.6rem;
			}
			.project-outputs ul {
				margin: 0;
				padding-left: 1.25rem;
			}
			.project-outputs li {
				font-size: 0.92rem;
				color: var(--color-text-muted);
				margin-bottom: 0.4rem;
				line-height: 1.5;
			}
			.project-outputs li strong {
				color: var(--color-text-main);
				font-weight: 600;
			}
			.project-audience {
				margin-top: 1.1rem;
				font-size: 0.9rem;
				font-style: italic;
				color: var(--color-text-muted);
			}
			.engagement-section h2 {
				margin-top: 0;
			}
			.engagement-list {
				list-style: none;
				padding: 0;
				margin: 1.5rem 0 0;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}
			.engagement-list li {
				padding-bottom: 1.25rem;
				border-bottom: 1px solid var(--color-border);
			}
			.engagement-list li:last-child {
				border-bottom: none;
				padding-bottom: 0;
			}
			.engagement-list strong {
				display: block;
				font-family: var(--font-serif);
				font-size: 1.1rem;
				color: var(--color-text-main);
				margin-bottom: 0.25rem;
			}
			.engagement-list span {
				color: var(--color-text-muted);
				font-size: 0.95rem;
				line-height: 1.6;
			}
			@media (max-width: 768px) {
				.projects-hero h1 { font-size: 2.1rem; }
				.project-card { padding: 1.5rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="projects-section">
			<div class="projects-hero">
				<h1>Research Projects</h1>
				<p>
					The research programmes I've led or contributed to, grouped by theme rather than by paper — useful if you're a student or academic looking to get a sense of the bigger picture, or wondering where a particular publication fits.
				</p>
			</div>

			<div class="project-list">
				{projects.map((project) => (
					<article class="project-card">
						<div class="project-header">
							<h2>{project.title}</h2>
							<span class="project-status">{project.status}</span>
						</div>
						<div class="project-meta-line">
							{project.years} &middot; {project.affiliation}
						</div>
						<p class="project-description">{project.description}</p>
						{project.outputs && project.outputs.length > 0 && (
							<div class="project-outputs">
								<div class="project-outputs-label">Key Outputs</div>
								<ul>
									{project.outputs.map((out) => (
										<li>
											{out.link ? (
												<a href={out.link} target="_blank" rel="noopener noreferrer"><strong>{out.title}</strong></a>
											) : (
												<strong>{out.title}</strong>
											)}
											{' '}&mdash; {out.venue}, {out.year}
										</li>
									))}
								</ul>
							</div>
						)}
						{project.audience && (
							<p class="project-audience">{project.audience}</p>
						)}
					</article>
				))}
			</div>

			<section class="engagement-section">
				<h2>Public Engagement & Community Initiatives</h2>
				<p style="color: var(--color-text-muted); max-width: 700px;">
					Alongside my research, I run and contribute to a few community initiatives aimed at making artificial life more visible and accessible &mdash; good entry points if you're new to the field or looking to get more involved.
				</p>
				<ul class="engagement-list">
					<li>
						<strong>ALife Expo</strong>
						<span>
							A public-facing digital exhibition making the big ideas of artificial life &mdash; emergence, self-organisation, evolution, complexity from simplicity &mdash; accessible with no background required. Co-curated with Martha Emerson, grown out of the public expo we organised at ALIFE 2025.
							<a href="https://alife-expo.org" target="_blank" rel="noopener noreferrer">Visit the ALife Expo &rarr;</a>
						</span>
					</li>
					<li>
						<strong>What ALife! Podcast</strong>
						<span>
							A show I host exploring artificial life and the people who study it, through conversations with researchers and practitioners across every career stage.
							<a href={url('/outreach/podcast')}>Listen to the podcast &rarr;</a>
						</span>
					</li>
					<li>
						<strong>ALife Newsletter & ALife and Society SIG</strong>
						<span>
							I'm part of the coordination team for the <a href="https://alife.org/category/newsletter/" target="_blank" rel="noopener noreferrer">ALife Newsletter</a>, a bi-monthly community digest, and I coordinate the ALife & Society Special Interest Group and interdisciplinary working group. I'm also the Education and Social Outreach Chair for the International Society of Artificial Life (ISAL) for 2026&ndash;28.
						</span>
					</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
